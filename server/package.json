{
	"name": "server",
	"version": "0.0.1",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "bun --watch run src/index.ts & tsc --watch",
		"db:generate": "bunx --bun drizzle-kit generate",
		"db:push": "bunx --bun drizzle-kit push",
		"db:migrate": "bunx --bun drizzle-kit migrate"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1009.0",
		"@better-auth/drizzle-adapter": "^1.5.5",
		"@hono/zod-validator": "^0.7.6",
		"better-auth": "^1.5.5",
		"drizzle-orm": "^0.45.1",
		"figures": "^6.1.0",
		"hono": "^4.12.8",
		"nanoid": "^5.1.7",
		"nodemailer": "^8.0.2",
		"pg": "^8.20.0",
		"picocolors": "^1.1.1",
		"postgres": "^3.4.8",
		"pretty-error": "^4.0.0",
		"resend": "^6.9.3",
		"shared": "workspace:*",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/pg": "^8.18.0",
		"drizzle-kit": "^0.31.10"
	}
}
