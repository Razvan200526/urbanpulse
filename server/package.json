{
	"name": "server",
	"version": "0.0.1",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "bun --watch run src/index.ts & tsc --watch",
		"db:seed": "bunx --bun typeorm-seeding seed -d ./src/shared/PrimaryDatabase.ts seeds/*.ts",
		"db:migration:generate": "bunx --bun typeorm migration:generate ./migrations/Initial -d ./src/shared/PrimaryDatabase.ts",
		"db:migration:run": "bunx --bun typeorm migration:run -d ./src/shared/PrimaryDatabase.ts",
		"db:migrate": "bun db:migration:generate && bun:migration:run && bun:seed"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1009.0",
		"@hono/zod-validator": "^0.7.6",
		"better-auth": "^1.5.5",
		"figures": "^6.1.0",
		"hono": "^4.12.8",
		"nanoid": "^5.1.7",
		"nodemailer": "^8.0.2",
		"pg": "^8.20.0",
		"picocolors": "^1.1.1",
		"pretty-error": "^4.0.0",
		"resend": "^6.9.3",
		"shared": "workspace:*",
		"typeorm": "^0.3.28",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@jorgebodega/typeorm-seeding": "^7.1.0",
		"@types/bun": "latest"
	}
}
